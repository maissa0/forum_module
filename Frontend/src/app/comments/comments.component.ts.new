import { Component, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormGroup, FormControl, Validators, ReactiveFormsModule } from '@angular/forms';
import { MatCardModule } from '@angular/material/card';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import { MatButtonModule } from '@angular/material/button';
import { MatIconModule } from '@angular/material/icon';
import { PickerModule } from '@ctrl/ngx-emoji-mart';

interface Comment {
  id: string;
  text: string;
  likes: number;
  dislikes: number;
  emojis: string[];
}

@Component({
  selector: 'app-comments',
  standalone: true,
  imports: [
    CommonModule,
    ReactiveFormsModule,
    MatCardModule,
    MatFormFieldModule,
    MatInputModule,
    MatButtonModule,
    MatIconModule,
    PickerModule
  ],
  template: `
    <div class="container">
      <mat-card class="comment-form-card fade-in">
        <mat-card-header>
          <mat-card-title>Nouveau Commentaire</mat-card-title>
        </mat-card-header>
        <mat-card-content>
          <form [formGroup]="commentForm" (ngSubmit)="onSubmit()" class="comment-form">
            <mat-form-field class="form-field-full-width">
              <mat-label>Votre commentaire</mat-label>
              <textarea matInput formControlName="text" rows="4"></textarea>
              <mat-error *ngIf="commentForm.get('text')?.errors?.['required']">
                Le commentaire est requis
              </mat-error>
            </mat-form-field>
            <button mat-raised-button color="primary" type="submit" [disabled]="!commentForm.valid">
              Publier
            </button>
          </form>
        </mat-card-content>
      </mat-card>

      <div class="comments-list mt-4">
        <mat-card *ngFor="let comment of comments" class="comment-card fade-in">
          <mat-card-content>
            <p>{{ comment.text }}</p>
            <div class="comment-actions">
              <button mat-icon-button (click)="onLike(comment)">
                <mat-icon>thumb_up</mat-icon>
                <span class="count">{{ comment.likes }}</span>
              </button>
              <button mat-icon-button (click)="onDislike(comment)">
                <mat-icon>thumb_down</mat-icon>
                <span class="count">{{ comment.dislikes }}</span>
              </button>
              <button mat-icon-button (click)="toggleEmojiPicker(comment)">
                <mat-icon>emoji_emotions</mat-icon>
              </button>
            </div>
            <div *ngIf="selectedComment === comment" class="emoji-picker-container">
              <emoji-mart (emojiSelect)="onEmojiSelect($event)"></emoji-mart>
            </div>
            <div class="emojis-list" *ngIf="comment.emojis?.length">
              {{ comment.emojis.join(' ') }}
            </div>
          </mat-card-content>
        </mat-card>
      </div>
    </div>
  `,
  styles: [`
    .comment-form-card {
      max-width: 800px;
      margin: 0 auto 2rem;
    }

    .comment-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
    }

    .comment-card {
      margin-bottom: 1rem;
    }

    .comment-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }

    .count {
      font-size: 0.875rem;
      margin-left: 4px;
    }

    .emoji-picker-container {
      margin-top: 1rem;
    }

    .emojis-list {
      margin-top: 0.5rem;
      font-size: 1.25rem;
    }
  `]
})
export class CommentsComponent implements OnInit {
  commentForm = new FormGroup({
    text: new FormControl('', [Validators.required])
  });

  comments: Comment[] = [];
  selectedComment: Comment | null = null;

  ngOnInit() {
    // Initialize with a sample comment
    const sampleComment: Comment = {
      id: '1',
      text: 'Premier commentaire',
      likes: 0,
      dislikes: 0,
      emojis: []
    };
    this.comments = [sampleComment];
  }

  onSubmit() {
    if (this.commentForm.valid) {
      const text = this.commentForm.value.text;
      const newComment: Comment = {
        id: Date.now().toString(),
        text: text || '',
        likes: 0,
        dislikes: 0,
        emojis: []
      };
      this.comments.unshift(newComment);
      this.commentForm.reset();
    }
  }

  onLike(comment: Comment) {
    comment.likes++;
  }

  onDislike(comment: Comment) {
    comment.dislikes++;
  }

  toggleEmojiPicker(comment: Comment) {
    this.selectedComment = this.selectedComment === comment ? null : comment;
  }

  onEmojiSelect(event: any) {
    if (this.selectedComment) {
      this.selectedComment.emojis.push(event.emoji.native);
      this.selectedComment = null;
    }
  }
}
